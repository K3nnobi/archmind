  if [[ ! -f "$CAPSLOCK_NODELAY_HELPER" || -L "$CAPSLOCK_NODELAY_HELPER" ]]; then
    warn "Caps Lock No Delay not found: $CAPSLOCK_NODELAY_HELPER"
    return 1
  fi
  bash "$CAPSLOCK_NODELAY_HELPER" --menu || \
    warn "The Caps Lock No Delay action was not completed."
}

open_firefox_chatgpt_emoji() {
  if [[ ! -f "$FIREFOX_EMOJI_HELPER" || -L "$FIREFOX_EMOJI_HELPER" ]]; then
    warn "Firefox / ChatGPT emoji helper not found: $FIREFOX_EMOJI_HELPER"
    return 1
  fi
  python3 -B "$FIREFOX_EMOJI_HELPER" --menu || \
    warn "The Firefox / ChatGPT emoji action was not completed."
}

configure_nvibrant_integration() {
  if [[ ! -f "$NVIBRANT_HELPER" ]]; then
    warn "NVIDIA Vibrance configurator not found: $NVIBRANT_HELPER"
    return 0
  fi
  bash "$NVIBRANT_HELPER" --apply || \
    warn "NVIDIA Vibrance was not applied; ArchMind will continue normally."
}

open_nvibrant_integration() {
  [[ -f "$NVIBRANT_HELPER" ]] || { warn "NVIDIA Vibrance configurator not found."; return 0; }
  bash "$NVIBRANT_HELPER" --menu || warn "The NVIDIA Vibrance action was not completed."
}

open_plymouth_patch() {
  [[ -f "$PLYMOUTH_PATCH_HELPER" ]] || { warn "Plymouth patch not found."; return 0; }
  bash "$PLYMOUTH_PATCH_HELPER" --menu || warn "The Plymouth action was not completed."
}

run_maintenance_tool() {
  local tool="$1"
  shift
  has python3 || { warn "Python 3 is required for Maintenance Center."; return 1; }
  [[ -f "$MAINTENANCE_TOOLS_DIR/$tool" ]] || { warn "Missing tool: $tool"; return 1; }
  ARCHMIND_DATA_HOME="$ROOT_DIR" ARCHMIND_BACKUP_DIR="$BACKUP_DIR" \
    python3 -B "$MAINTENANCE_TOOLS_DIR/$tool" "$@"
}

maintenance_menu() {
  local choice
  while true; do
    header
    cat <<'EOF'

MAINTENANCE CENTER

1) Hardware profile
2) Update Guardian
3) Tarefas pendentes
4) Rollback Center
5) Limpeza segura
6) Backup catalog
7) Operating profiles

0) Back
EOF
    read -rp "> " choice
    case "$choice" in
      1) run_maintenance_tool hardware-profile.py; pause ;;
      2) run_maintenance_tool update-guardian.py; pause ;;
      3) run_maintenance_tool pending-tasks.py --interactive; pause ;;
      4) run_maintenance_tool rollback-center.py --interactive; pause ;;
      5) run_maintenance_tool cleanup-audit.py --interactive; pause ;;
      6) run_maintenance_tool backup-catalog.py --interactive; pause ;;
      7) run_maintenance_tool operating-profiles.py --interactive; pause ;;
      0) return ;;
      *) warn "Invalid option."; pause ;;
    esac
  done
}

capture_gnome() {
  local target="$1"
  mkdir -p "${target}/extensions" "${target}/dconf"

  if [[ -d "$USER_EXT_DIR" ]]; then
    cp -a "${USER_EXT_DIR}/." "${target}/extensions/"
  fi

  if has gnome-extensions; then
    gnome-extensions list | sort > "${target}/extensions-all.txt"
    gnome-extensions list --enabled | sort > "${target}/extensions-enabled.txt"
    gnome-extensions list --disabled | sort > "${target}/extensions-disabled.txt"
  fi

  if has dconf; then
    dconf dump /org/gnome/shell/ \
      > "${target}/dconf/gnome-shell.dconf" 2>/dev/null || true

    dconf dump /org/gnome/shell/extensions/ \
      > "${target}/dconf/extensions.dconf" 2>/dev/null || true

    dconf dump /org/gnome/desktop/interface/ \
      > "${target}/dconf/interface.dconf" 2>/dev/null || true

    dconf dump /org/gnome/desktop/background/ \
      > "${target}/dconf/background.dconf" 2>/dev/null || true

    dconf dump /org/gnome/desktop/wm/preferences/ \
      > "${target}/dconf/window-manager.dconf" 2>/dev/null || true
  fi
}

capture_packages() {
  local target="$1"
  mkdir -p "$target"

  pacman -Q > "${target}/pacman-all.txt"
  pacman -Qqe > "${target}/pacman-explicit.txt"
  pacman -Qqen > "${target}/pacman-native.txt"
  pacman -Qqem > "${target}/pacman-aur.txt"

  has flatpak && \
    flatpak list --app --columns=application \
      > "${target}/flatpak-apps.txt" 2>/dev/null || true
}

capture_project() {
  local target="$1"
  mkdir -p "$target"

  if [[ -z "$(find "$PROJECT_DIR" -mindepth 1 -print -quit 2>/dev/null)" ]]; then
    warn "The project directory is empty: $PROJECT_DIR"
  else
    cp -a "${PROJECT_DIR}/." "$target/"
  fi
}

create_backup() {
  require_arch
  ensure_dirs

  local mode="$1"
  local stamp work output

  stamp="$(date +'%Y%m%d-%H%M%S')"
  work="$(make_temp_dir)"
  output="${BACKUP_DIR}/ArchMind-${mode}-${stamp}.archmind"

  info "Creating backup: $mode"

  case "$mode" in
    completo)
      capture_configs "${work}/configs"
      capture_gnome "${work}/gnome"
      capture_packages "${work}/packages"
      capture_project "${work}/project"
      ;;
    configuracoes)
      capture_configs "${work}/configs"
      ;;
    gnome)
      capture_gnome "${work}/gnome"
      ;;
    pacotes)
      capture_packages "${work}/packages"
      ;;
    projeto)
      capture_project "${work}/project"
      ;;
    *)
      remove_temp_dir "$work"
      die "Invalid mode."
      ;;
  esac

  local pacman_count=0 aur_count=0 flatpak_count=0 extension_count=0
  [[ -f "${work}/packages/pacman-native.txt" ]] && pacman_count="$(grep -cve '^$' "${work}/packages/pacman-native.txt" || true)"
  [[ -f "${work}/packages/pacman-aur.txt" ]] && aur_count="$(grep -cve '^$' "${work}/packages/pacman-aur.txt" || true)"
  [[ -f "${work}/packages/flatpak-apps.txt" ]] && flatpak_count="$(grep -cve '^$' "${work}/packages/flatpak-apps.txt" || true)"
  [[ -f "${work}/gnome/extensions-all.txt" ]] && extension_count="$(grep -cve '^$' "${work}/gnome/extensions-all.txt" || true)"

  cat > "${work}/manifest.txt" <<EOF
format=archmind
version=${VERSION}
mode=${mode}
created=$(date --iso-8601=seconds)
hostname=${HOSTNAME:-unknown}
user=${USER}
pacman_packages=${pacman_count}
aur_packages=${aur_count}
flatpak_apps=${flatpak_count}
gnome_extensions=${extension_count}
has_configs=$([[ -d "${work}/configs" ]] && echo yes || echo no)
has_gnome=$([[ -d "${work}/gnome" ]] && echo yes || echo no)
has_packages=$([[ -d "${work}/packages" ]] && echo yes || echo no)
has_project=$([[ -d "${work}/project" ]] && echo yes || echo no)
EOF

  pack_archmind "$work" "$output"
  remove_temp_dir "$work"
}

ensure_home_destination_writable() {
  local destination="$1"

  [[ -e "$destination" || -L "$destination" ]] || return 0
  [[ -w "$destination" ]] && return 0

  warn "Permission denied while overwriting: $destination"
  if ! confirm "Change ownership of this path to ${USER}?"; then
    error "Restoration stopped to avoid changing a path without permission."
    return 1
  fi

  sudo chown -R "${USER}:$(id -gn)" -- "$destination" || {
    error "Could not correct ownership of: $destination"
    return 1
  }
}

restore_home_item() {
  local source="$1"
  local destination="$2"

  ensure_home_destination_writable "$destination" || return 1
  mkdir -p -- "$(dirname "$destination")"

  if [[ -d "$source" && ! -L "$source" ]]; then
    mkdir -p -- "$destination"
    cp -a -- "$source/." "$destination/"
  else
    cp -a -- "$source" "$destination"
  fi || {
    error "Failed to restore: $destination"
    return 1
  }
}

restore_config_tree() {
  local source="$1"
  local item name

  mkdir -p "${HOME}/.config"
  while IFS= read -r -d '' item; do
    name="$(basename "$item")"

    # The project is restored in its own step. Backups 1.4.1 and older also
    # stored it inside configs/.config; copying it here could reintroduce the
    # defective Manager during restoration itself.
    [[ "$name" == "archmind" ]] && continue

    restore_home_item "$item" "${HOME}/.config/${name}" || return 1
  done < <(find "$source" -mindepth 1 -maxdepth 1 -print0)
}

restore_local_tree() {
  local source="$1"
  local item name bin_item bin_name share_item share_name

  mkdir -p "${HOME}/.local"
  while IFS= read -r -d '' item; do
    name="$(basename "$item")"

    if [[ "$name" == "bin" && -d "$item" ]]; then
      mkdir -p "${HOME}/.local/bin"
      while IFS= read -r -d '' bin_item; do
        bin_name="$(basename "$bin_item")"
        [[ "$bin_name" == "archmind" || "$bin_name" == "archmind-console" || "$bin_name" == "archmind-monitor" ]] && continue
        restore_home_item "$bin_item" "${HOME}/.local/bin/${bin_name}" || return 1
      done < <(find "$item" -mindepth 1 -maxdepth 1 -print0)
      continue
    fi

    if [[ "$name" == "share" && -d "$item" ]]; then
      mkdir -p "${HOME}/.local/share"
      while IFS= read -r -d '' share_item; do
        share_name="$(basename "$share_item")"
        [[ "$share_name" == "archmind-toolkit" ]] && continue
        restore_home_item "$share_item" "${HOME}/.local/share/${share_name}" || return 1
      done < <(find "$item" -mindepth 1 -maxdepth 1 -print0)
      continue
    fi

    restore_home_item "$item" "${HOME}/.local/${name}" || return 1
  done < <(find "$source" -mindepth 1 -maxdepth 1 -print0)
}

ensure_zsh_runtime_config() {
  local zshrc="${HOME}/.zshrc"
  local candidate backup changed=false
  local legacy target
  for legacy in .zsh_aliases .p10k.zsh; do
    case "$legacy" in
      .zsh_aliases) target="$ALIASES_FILE" ;;
      .p10k.zsh) target="$P10K_FILE" ;;
    esac
    if [[ -f "$target" && ! -e "$HOME/$legacy" && ! -L "$HOME/$legacy" ]]; then
      ln -s -- "$target" "$HOME/$legacy" || return 1
    fi
  done

  [[ -e "$zshrc" ]] || { : > "$zshrc"; chmod 600 -- "$zshrc"; }
  ensure_home_destination_writable "$zshrc" || return 1

  candidate="$(mktemp "${TEMP_DIR}/zshrc.XXXXXX")"
  cp -- "$zshrc" "$candidate"

  sed -i \
    -e '/^[[:space:]]*\[\[.*\.zsh_aliases.*source.*\.zsh_aliases.*$/d' \
    -e '/^[[:space:]]*\[\[.*\.p10k\.zsh.*source.*\.p10k\.zsh.*$/d' \
    "$candidate"

  if ! grep -qxF 'export PATH="$HOME/.local/bin:$PATH"' "$candidate"; then
    printf '\n%s\n' 'export PATH="$HOME/.local/bin:$PATH"' >> "$candidate"
    changed=true
  fi

  if [[ -f "$ALIASES_FILE" ]] && \
     ! grep -qF '$HOME/ArchMind/Config/Zsh/aliases.zsh' "$candidate"; then
    printf '\n%s\n' '[[ -r "$HOME/ArchMind/Config/Zsh/aliases.zsh" ]] && source "$HOME/ArchMind/Config/Zsh/aliases.zsh"' >> "$candidate"
    changed=true
  fi

  if [[ -f "$P10K_FILE" ]] && \
     ! grep -qF '$HOME/ArchMind/Config/Zsh/p10k.zsh' "$candidate"; then
    printf '\n%s\n' '[[ -r "$HOME/ArchMind/Config/Zsh/p10k.zsh" ]] && source "$HOME/ArchMind/Config/Zsh/p10k.zsh"' >> "$candidate"
    changed=true
  fi

  if ! grep -qF '/usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh' "$candidate"; then
    printf '\n%s\n' '[[ -r /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh' >> "$candidate"
    changed=true
  fi

  if ! grep -qF 'autoload -Uz compinit' "$candidate"; then
    printf '\n%s\n%s\n' 'autoload -Uz compinit' 'compinit' >> "$candidate"
    changed=true
  fi

  if ! grep -qF '/usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme' "$candidate"; then
    printf '\n%s\n' '[[ -r /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme ]] && source /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme' >> "$candidate"
    changed=true
  fi

  # syntax-highlighting must be loaded after the other plugins.
  if ! grep -qF '/usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh' "$candidate"; then
    printf '\n%s\n' '[[ -r /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh' >> "$candidate"
    changed=true
  fi

  if [[ "$changed" == false ]]; then
    rm -f -- "$candidate"
    ok "Zsh, plugins, and aliases were already linked."
    return 0
  fi

  if has zsh && ! zsh -n "$candidate"; then
    rm -f -- "$candidate"
    warn "The restored .zshrc contains a syntax error; automatic links were not applied."
    return 0
  fi

  backup="${SAFETY_DIR}/zshrc-before-finalize-$(date +'%Y%m%d-%H%M%S')"
  cp -a -- "$zshrc" "$backup"
  cp -- "$candidate" "$zshrc"
  chmod --reference="$backup" "$zshrc" 2>/dev/null || chmod 600 -- "$zshrc"
  rm -f -- "$candidate"

  ok "Zsh, plugins, PATH e aliases externos vinculados."
  ok "Safety copy of .zshrc: $backup"
}

restore_configs() {
  local source="$1"

  [[ -d "${source}/configs" ]] || {
    warn "This backup does not contain settings."
    return 0
  }

  info "Restoring settings..."

  if [[ -d "${source}/configs/.config" ]]; then
    restore_config_tree "${source}/configs/.config" || return 1
  fi

  if [[ -d "${source}/configs/archmind-config" ]]; then
    restore_home_item "${source}/configs/archmind-config" "$CONFIG_DIR" || return 1
  fi

  if [[ -d "${source}/configs/archmind-doctor-reports" ]]; then
    if [[ -f "$PROJECT_DIR/tools/doctor-report.py" ]] && has python3; then
      python3 -B "$PROJECT_DIR/tools/doctor-report.py" --import "${source}/configs/archmind-doctor-reports" || \
        warn "Doctor report restore was incomplete; existing reports were preserved."
    else
      warn "Doctor reports were not restored: the report helper or Python is missing."
    fi
  fi

  if [[ -d "${source}/configs/zsh-linked" ]]; then
    info "Restoring modules and files linked by Zsh..."

    local linked relative destination
    while IFS= read -r -d '' linked; do
      relative="${linked#${source}/configs/zsh-linked/}"
      case "$relative" in
        .zsh_aliases) destination="$ALIASES_FILE" ;;
        .p10k.zsh) destination="$P10K_FILE" ;;
        *) destination="${HOME}/${relative}" ;;
      esac

      restore_home_item "$linked" "$destination" || return 1
    done < <(
      find "${source}/configs/zsh-linked" -type f -print0
    )
  fi

  local item base
  while IFS= read -r -d '' item; do
    base="$(basename "$item")"

    case "$base" in
      .config|archmind-config|archmind-doctor-reports|zsh-linked|zsh-files.txt)
        continue
        ;;
      .zsh_aliases)
        restore_home_item "$item" "$ALIASES_FILE" || return 1
        continue
        ;;
      .p10k.zsh)
        restore_home_item "$item" "$P10K_FILE" || return 1
        continue
        ;;
      .local)
        restore_local_tree "$item" || return 1
        continue
        ;;
    esac

    restore_home_item "$item" "${HOME}/${base}" || return 1
  done < <(
    find "${source}/configs" -mindepth 1 -maxdepth 1 -print0
  )

  ensure_zsh_runtime_config || return 1
  ok "Settings restored."
}

restore_gnome() {
  local source="$1"

  [[ -d "${source}/gnome" ]] || {
    warn "This backup does not contain GNOME data."
    return 0
  }

  info "Restoring GNOME and extensions..."
  mkdir -p "$USER_EXT_DIR"

  [[ -d "${source}/gnome/extensions" ]] && \
    cp -a "${source}/gnome/extensions/." "$USER_EXT_DIR/"

  if has dconf; then
    [[ -s "${source}/gnome/dconf/interface.dconf" ]] && \
      dconf load /org/gnome/desktop/interface/ \
        < "${source}/gnome/dconf/interface.dconf"

    [[ -s "${source}/gnome/dconf/background.dconf" ]] && \
      dconf load /org/gnome/desktop/background/ \
        < "${source}/gnome/dconf/background.dconf"

    [[ -s "${source}/gnome/dconf/window-manager.dconf" ]] && \
      dconf load /org/gnome/desktop/wm/preferences/ \
        < "${source}/gnome/dconf/window-manager.dconf"

    [[ -s "${source}/gnome/dconf/extensions.dconf" ]] && \
      dconf load /org/gnome/shell/extensions/ \
        < "${source}/gnome/dconf/extensions.dconf"

    [[ -s "${source}/gnome/dconf/gnome-shell.dconf" ]] && \
      dconf load /org/gnome/shell/ \
        < "${source}/gnome/dconf/gnome-shell.dconf"
  fi

  if has gnome-extensions && [[ -f "${source}/gnome/extensions-enabled.txt" ]]; then
    local uuid

    if [[ -f "${source}/gnome/extensions-all.txt" ]]; then
      while IFS= read -r uuid; do
        [[ -n "$uuid" ]] || continue
        gnome-extensions disable "$uuid" 2>/dev/null || true
      done < "${source}/gnome/extensions-all.txt"
    fi

    while IFS= read -r uuid; do
      [[ -n "$uuid" ]] || continue
      gnome-extensions enable "$uuid" 2>/dev/null \
        || warn "Could not enable: $uuid"
    done < "${source}/gnome/extensions-enabled.txt"
  fi

  ok "GNOME and extensions restored."
}

normalize_package_list() {
  local source="$1"
  local destination="$2"

  if [[ -f "$source" ]]; then
    tr -d '\r' < "$source" \
      | sed '/^[[:space:]]*$/d' \
      | LC_ALL=C sort -u > "$destination"
  else
    : > "$destination"
  fi
}

append_unique_packages() {
  local file="$1"
  shift
  printf '%s\n' "$@" >> "$file"
  LC_ALL=C sort -u -o "$file" "$file"
}

package_missing_list() {
  local requested="$1"
  local installed="$2"
  local output="$3"

  # sort and comm must share the same locale. This prevents the error
  # observed in pt_BR: "file 2 is not sorted".
  LC_ALL=C sort -u -o "$requested" "$requested"
  LC_ALL=C sort -u -o "$installed" "$installed"
  LC_ALL=C comm -23 "$requested" "$installed" > "$output"
}

filter_official_packages() {
  local requested="$1"
  local available="$2"
  local unavailable="$3"
  local package

  : > "$available"
  : > "$unavailable"
  while IFS= read -r package; do
    [[ -n "$package" ]] || continue
    if pacman -Si -- "$package" >/dev/null 2>&1; then
      printf '%s\n' "$package" >> "$available"
    else
      printf '%s\n' "$package" >> "$unavailable"
    fi
  done < "$requested"
}

filter_aur_packages() {
  local requested="$1"
  local available="$2"
  local unavailable="$3"
  local package

  : > "$available"
  : > "$unavailable"
  while IFS= read -r package; do
    [[ -n "$package" ]] || continue
    if yay -Si -- "$package" >/dev/null 2>&1; then
      printf '%s\n' "$package" >> "$available"
    else
      printf '%s\n' "$package" >> "$unavailable"
    fi
  done < "$requested"
}

install_official_packages() {
  local available="$1"
  local failed="$2"
  local package
  local packages=()

  : > "$failed"
  [[ -s "$available" ]] || return 0
  mapfile -t packages < "$available"

  info "Installing ${#packages[@]} available official package(s)..."
  if sudo pacman -S --needed --noconfirm -- "${packages[@]}"; then
    return 0
  fi

  warn "The official package batch failed; trying packages separately."
  for package in "${packages[@]}"; do
    sudo pacman -S --needed --noconfirm -- "$package" || \
      printf '%s\n' "$package" >> "$failed"
  done
}

install_aur_packages() {
  local available="$1"
  local failed="$2"
  local package

  : > "$failed"
  [[ -s "$available" ]] || return 0

  info "Installing available AUR packages..."
  while IFS= read -r package; do
    [[ -n "$package" ]] || continue
    yay -S --needed --noconfirm -- "$package" || \
      printf '%s\n' "$package" >> "$failed"
  done < "$available"
}

restore_packages() {
  local source="$1"
  local stamp report work
  local official_requested aur_requested official_missing aur_missing
  local official_available official_unavailable official_failed
  local aur_available aur_unavailable aur_failed
  local installed_all installed_foreign app

  [[ -d "${source}/packages" ]] || {
    warn "This backup does not contain packages."
    return 0
  }

  stamp="$(date +'%Y%m%d-%H%M%S')"
  report="${LOG_DIR}/package-restore-${stamp}"
  work="$(make_temp_dir)"
  mkdir -p "$report"

  official_requested="${report}/official-requested.txt"
  aur_requested="${report}/aur-requested.txt"
  official_missing="${report}/official-missing-before.txt"
  aur_missing="${report}/aur-missing-before.txt"
  official_available="${report}/official-available.txt"
  official_unavailable="${report}/official-unavailable.txt"
  official_failed="${report}/official-failed.txt"
  aur_available="${report}/aur-available.txt"
  aur_unavailable="${report}/aur-unavailable.txt"
  aur_failed="${report}/aur-failed.txt"
  installed_all="${work}/installed-all.txt"
  installed_foreign="${work}/installed-foreign.txt"

  normalize_package_list "${source}/packages/pacman-native.txt" "$official_requested"
  normalize_package_list "${source}/packages/pacman-aur.txt" "$aur_requested"

  # Ensure the approved terminal setup even for old backups that recorded only
  # .zshrc but not the packages providing its plugins.
  append_unique_packages "$official_requested" \
    zsh zsh-autosuggestions zsh-syntax-highlighting zsh-completions
  append_unique_packages "$aur_requested" zsh-theme-powerlevel10k-git
  if [[ -f "${source}/configs/.local/share/thumbnailers/exe-thumbnailer.thumbnailer" ]]; then
    append_unique_packages "$official_requested" python-pillow icoutils
    append_unique_packages "$aur_requested" icoextract
  fi
  if [[ -d "${source}/gnome" ]]; then
    append_unique_packages "$official_requested" papirus-icon-theme
    append_unique_packages "$aur_requested" gnome-rounded-blur papirus-folders
  fi
  if [[ -f "${source}/configs/.config/gamemode.ini" ]] && \
     grep -Fq '; BEGIN ARCHMIND GAMEMODE BLUR' \
       "${source}/configs/.config/gamemode.ini"; then
    append_unique_packages "$official_requested" gamemode lib32-gamemode
  fi
  if [[ -f "${source}/configs/archmind-config/Patches/Plymouth/state.conf" ]]; then
    append_unique_packages "$official_requested" plymouth
  fi
  [[ -s "${source}/packages/flatpak-apps.txt" ]] && \
    append_unique_packages "$official_requested" flatpak

  pacman -Qq | LC_ALL=C sort -u > "$installed_all"
  pacman -Qqm | LC_ALL=C sort -u > "$installed_foreign"
  package_missing_list "$official_requested" "$installed_all" "$official_missing"
  package_missing_list "$aur_requested" "$installed_foreign" "$aur_missing"

  printf '\nMissing official packages: %s\n' "$(count_nonempty_lines "$official_missing")"
  printf 'Missing AUR packages:      %s\n' "$(count_nonempty_lines "$aur_missing")"
  printf 'Report:                    %s\n\n' "$report"

  if [[ -s "$official_missing" || -s "$aur_missing" ]]; then
    info "Updating Arch Linux before recovery..."
    sudo pacman -Syu --noconfirm || {
      remove_temp_dir "$work"
      error "The system update failed; settings will not be restored in this run."
      return 1
    }

    filter_official_packages "$official_missing" "$official_available" "$official_unavailable"
    install_official_packages "$official_available" "$official_failed"

    if [[ -s "$aur_missing" ]]; then
      if ! has yay; then
        warn "yay is required to restore AUR packages."
        if confirm "Install yay now?"; then
          install_yay || warn "Failed to install yay; AUR packages will remain recorded as pending."
        fi
      fi

      if has yay; then
        filter_aur_packages "$aur_missing" "$aur_available" "$aur_unavailable"
        install_aur_packages "$aur_available" "$aur_failed"
      else
        cp -- "$aur_missing" "$aur_unavailable"
        : > "$aur_failed"
      fi
    else
      : > "$aur_available"
      : > "$aur_unavailable"
      : > "$aur_failed"
    fi
  else
    : > "$official_available"
    : > "$official_unavailable"
    : > "$official_failed"
    : > "$aur_available"
    : > "$aur_unavailable"
    : > "$aur_failed"
  fi

  if [[ -s "${source}/packages/flatpak-apps.txt" ]]; then
    if has flatpak; then
      while IFS= read -r app; do
        [[ -n "$app" ]] || continue
        flatpak install -y flathub "$app" || \
          printf '%s\n' "$app" >> "${report}/flatpak-failed.txt"
      done < "${source}/packages/flatpak-apps.txt"
    else
      cp -- "${source}/packages/flatpak-apps.txt" "${report}/flatpak-failed.txt"
    fi
  fi

  pacman -Qq | LC_ALL=C sort -u > "$installed_all"
  pacman -Qqm | LC_ALL=C sort -u > "$installed_foreign"
  package_missing_list "$official_requested" "$installed_all" "${report}/official-still-missing.txt"
  package_missing_list "$aur_requested" "$installed_foreign" "${report}/aur-still-missing.txt"

  ok "Package restoration complete."
  printf 'Official packages still missing: %s\n' "$(count_nonempty_lines "${report}/official-still-missing.txt")"
  printf 'AUR packages still missing:      %s\n' "$(count_nonempty_lines "${report}/aur-still-missing.txt")"
  printf 'Full report:             %s\n' "$report"

  if [[ -s "${report}/official-still-missing.txt" || \
        -s "${report}/aur-still-missing.txt" ]]; then
    warn "Some packages remain pending; their names are listed in the report above."
  fi

  remove_temp_dir "$work"
}

version_is_older() {
  local candidate="$1"
  local current="$2"
  local first

  [[ -n "$candidate" && "$candidate" != "$current" ]] || return 1
  first="$(printf '%s\n%s\n' "$candidate" "$current" | sort -V | head -n1)"
  [[ "$first" == "$candidate" ]]
}

restore_project() {
  local source="$1"

  [[ -d "${source}/project" ]] || {
    warn "This backup does not contain the ArchMind project."
    return 0
  }

  local stamp backup_version recovered setting
  local safety
  stamp="$(date +'%Y%m%d-%H%M%S')"
  safety="${SAFETY_DIR}/project-before-restore-${stamp}"
  backup_version="$(manifest_value "${source}/manifest.txt" version)"
  mkdir -p "$safety"

  if [[ -n "$(find "$PROJECT_DIR" -mindepth 1 -print -quit 2>/dev/null)" ]]; then
    cp -a "${PROJECT_DIR}/." "$safety/"
    ok "Project safety copy: $safety"
  fi

  if version_is_older "$backup_version" "$VERSION"; then
    recovered="${ROOT_DIR}/Recovered-Projects/ArchMind-${backup_version:-unknown}-${stamp}"
    mkdir -p "$recovered"
    cp -a "${source}/project/." "$recovered/" || return 1

    # Personal preferences can be restored without replacing stable code.
    for setting in config/settings.zsh config/archmind.conf; do
      if [[ -f "${source}/project/${setting}" ]]; then
        if [[ "$setting" == "config/settings.zsh" ]]; then
          restore_home_item "${source}/project/${setting}" "${CONFIG_DIR}/settings.zsh" || return 1
        else
          restore_home_item "${source}/project/${setting}" "${PROJECT_DIR}/${setting}" || return 1
        fi
      fi
    done

    warn "The backup contains ArchMind ${backup_version}; stable installation ${VERSION} was preserved."
    ok "The previous project was saved separately at: $recovered"
    return 0
  fi

  find "$PROJECT_DIR" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + || return 1
  cp -a "${source}/project/." "$PROJECT_DIR/" || return 1

  ok "ArchMind project restored to: $PROJECT_DIR"
}

manifest_value() {
  local manifest="$1"
  local key="$2"
  awk -F= -v key="$key" '$1 == key {sub(/^[^=]*=/, ""); print; exit}' "$manifest" 2>/dev/null
}

count_nonempty_lines() {
  local file="$1"
  [[ -f "$file" ]] || { echo 0; return; }
  grep -cve '^$' "$file" 2>/dev/null || true
}

show_backup_summary() {
  local source="$1"
  local manifest="${source}/manifest.txt"
  local created host version mode
  local native_count aur_count flatpak_count extension_count

  created="$(manifest_value "$manifest" created)"
  host="$(manifest_value "$manifest" hostname)"
  version="$(manifest_value "$manifest" version)"
  mode="$(manifest_value "$manifest" mode)"

  native_count="$(manifest_value "$manifest" pacman_packages)"
  aur_count="$(manifest_value "$manifest" aur_packages)"
  flatpak_count="$(manifest_value "$manifest" flatpak_apps)"
  extension_count="$(manifest_value "$manifest" gnome_extensions)"

  [[ -n "$native_count" ]] || native_count="$(count_nonempty_lines "${source}/packages/pacman-native.txt")"
  [[ -n "$aur_count" ]] || aur_count="$(count_nonempty_lines "${source}/packages/pacman-aur.txt")"
  [[ -n "$flatpak_count" ]] || flatpak_count="$(count_nonempty_lines "${source}/packages/flatpak-apps.txt")"
  [[ -n "$extension_count" ]] || extension_count="$(count_nonempty_lines "${source}/gnome/extensions-all.txt")"

  echo
  echo "BACKUP SUMMARY"
  echo
  printf '  Date:                 %s\n' "${created:-unknown}"
  printf '  Computer:             %s\n' "${host:-unknown}"
  printf '  ArchMind version:     %s\n' "${version:-unknown}"
  printf '  Type:                 %s\n' "${mode:-unknown}"
  echo
  printf '  Settings:             %s\n' "$([[ -d "${source}/configs" ]] && echo 'Yes' || echo 'No')"
  printf '  GNOME and extensions: %s (%s extension(s))\n' "$([[ -d "${source}/gnome" ]] && echo 'Yes' || echo 'No')" "$extension_count"
  printf '  Official packages:    %s\n' "$native_count"
  printf '  AUR packages:         %s\n' "$aur_count"
  printf '  Flatpak applications: %s\n' "$flatpak_count"
  printf '  ArchMind project:     %s\n' "$([[ -d "${source}/project" ]] && echo 'Yes' || echo 'No')"
  echo
}

restore_selected_components() {
  local source="$1"
  local do_packages="$2"
  local do_configs="$3"
  local do_gnome="$4"
  local do_project="$5"

  # On a new installation, programs must exist before their settings.
  if [[ "$do_packages" == true ]]; then
    restore_packages "$source" || return 1
  fi
  if [[ "$do_configs" == true ]]; then
    restore_configs "$source" || return 1
  fi
  if [[ "$do_gnome" == true ]]; then
    restore_gnome "$source" || return 1
  fi
  if [[ "$do_project" == true ]]; then
    restore_project "$source" || return 1
  fi

  if [[ "$do_packages" == true || "$do_configs" == true ]]; then
    ensure_zsh_runtime_config || return 1
  fi

  if [[ "$do_configs" == true || "$do_gnome" == true ]]; then
    configure_nautilus_integration
    configure_gnome_appearance_integration
  fi
  if [[ "$do_packages" == true || "$do_configs" == true || "$do_gnome" == true ]]; then
    configure_gamemode_blur_integration
  fi
  if [[ "$do_configs" == true ]] && \
     [[ -f "$CONFIG_DIR/NVIDIA/vibrance.conf" || \
        -f "$HOME/.config/systemd/user/nvibrant.service" ]]; then
    configure_nvibrant_integration
  fi
}

choose_restore_components() {
  local source="$1"
  local do_packages=false do_configs=false do_gnome=false do_project=false

  echo
  echo "Select the available components:"
  echo

  if [[ -d "${source}/configs" ]] && confirm "Restore user settings and Zsh?"; then
    do_configs=true
  fi

  if [[ -d "${source}/gnome" ]] && confirm "Restore GNOME and extensions?"; then
    do_gnome=true
  fi

  if [[ -d "${source}/project" ]] && confirm "Restore the ArchMind project?"; then
    do_project=true
  fi

  if [[ -d "${source}/packages" ]]; then
    warn "Package installation may take time and download a large amount of data."
    if confirm "Reinstall packages recorded in the backup?"; then
      do_packages=true
    fi
  fi

  if [[ "$do_packages" == false && "$do_configs" == false && "$do_gnome" == false && "$do_project" == false ]]; then
    warn "No component selected."
    return 0
  fi

  echo
  echo "Componentes selecionados:"
  [[ "$do_packages" == true ]] && echo "  - Packages (executed first)"
  [[ "$do_configs" == true ]] && echo "  - Settings and Zsh"
  [[ "$do_gnome" == true ]] && echo "  - GNOME and extensions"
  [[ "$do_project" == true ]] && echo "  - ArchMind project"
  echo

  confirm "Confirm the selected restoration?" || { warn "Restoration cancelled."; return 0; }
  backup_safety || return 1
  restore_selected_components "$source" "$do_packages" "$do_configs" "$do_gnome" "$do_project" || return 1
}

restore_backup() {
  local mode="$1"
  local pattern backup extracted option

  case "$mode" in
    completo) pattern='ArchMind-completo-*.archmind' ;;
    configuracoes) pattern='ArchMind-configuracoes-*.archmind' ;;
    gnome) pattern='ArchMind-gnome-*.archmind' ;;
    pacotes) pattern='ArchMind-pacotes-*.archmind' ;;
    projeto) pattern='ArchMind-projeto-*.archmind' ;;
    qualquer) pattern='ArchMind-*.archmind' ;;
    *) die "Invalid mode." ;;
  esac

  backup="$(latest_backup "$pattern")"

  [[ -n "$backup" ]] || {
    error "No backup found for: $mode"
    return 1
  }

  info "Backup found:"
  echo "  $backup"

  extracted="$(extract_archmind "$backup")"
  if ! (verify_extracted "$extracted"); then
    remove_temp_dir "$extracted" || true
    return 1
  fi
  show_backup_summary "$extracted"

  case "$mode" in
    configuracoes)
      confirm "Restore settings from this backup?" || { remove_temp_dir "$extracted"; return 0; }
      backup_safety
      restore_configs "$extracted"
      ;;
    gnome)
      confirm "Restore GNOME and extensions from this backup?" || { remove_temp_dir "$extracted"; return 0; }
      backup_safety
      restore_gnome "$extracted"
      ;;
    pacotes)
      warn "This operation will reinstall the recorded packages."
      confirm "Proceed with package installation?" || { remove_temp_dir "$extracted"; return 0; }
      restore_packages "$extracted"
      ;;
    projeto)
      confirm "Restore the ArchMind project from this backup?" || { remove_temp_dir "$extracted"; return 0; }
      backup_safety
      restore_project "$extracted"
      ;;
    completo|qualquer)
      echo "Choose the restoration mode:"
      echo
      echo "1) Restore settings, GNOME, and project (without installing packages)"
      echo "2) Restore everything, including package installation"
      echo "3) Escolher componentes manualmente"
      echo "0) Cancel"
      echo
      read -rp "Choice: " option

      case "$option" in
        1)
          confirm "Confirm restoration without installing packages?" || { remove_temp_dir "$extracted"; return 0; }
          backup_safety
          restore_selected_components "$extracted" false true true true
          ;;
        2)
          warn "Packages will be installed before settings are restored."
          confirm "Confirm full restoration with packages?" || { remove_temp_dir "$extracted"; return 0; }
          backup_safety
          restore_selected_components "$extracted" true true true true
          ;;
        3)
          choose_restore_components "$extracted" || true
          ;;
        0)
          warn "Cancelled."
          ;;
        *)
          warn "Invalid option."
          ;;
      esac
      ;;
  esac

  remove_temp_dir "$extracted"
  warn "Log out and back in after restoring GNOME or Zsh."
}


show_restore_plan() {
  local source="$1"
  local do_packages="$2"
  local do_configs="$3"
  local do_gnome="$4"
  local do_project="$5"
  local simulation="${6:-false}"

  echo
  if [[ "$simulation" == true ]]; then
    echo "SIMULATION — NO CHANGES WILL BE MADE"
  else
    echo "RESTORATION PLAN"
  fi
  echo

  [[ "$do_packages" == true ]] && {
    echo "  1. Install packages recorded in the backup"
    printf '     Official: %s | AUR: %s | Flatpak: %s\n' \
      "$(count_nonempty_lines "${source}/packages/pacman-native.txt")" \
      "$(count_nonempty_lines "${source}/packages/pacman-aur.txt")" \
      "$(count_nonempty_lines "${source}/packages/flatpak-apps.txt")"
  }

  [[ "$do_configs" == true ]] && {
    echo "  2. Restore user settings and Zsh"
    echo "     Main destinations: ~/.config and hidden files in Home"
  }

  [[ "$do_gnome" == true ]] && {
    echo "  3. Restore GNOME, dconf, and extensions"
    echo "     May require logging out and back in"
  }

  [[ "$do_project" == true ]] && {
    echo "  4. Restore the ArchMind project"
    echo "     Destination: $PROJECT_DIR"
  }

  echo
  if [[ "$do_packages" == false && "$do_configs" == false && "$do_gnome" == false && "$do_project" == false ]]; then
    warn "No component selected for the plan."
    return 1
  fi

  [[ "$simulation" == true ]] && {
    echo "  The safety copy would be created in: $SAFETY_DIR"
    echo "  No file was copied, removed, or installed."
    echo
  }

  # The final test above returns 1 for real plans (simulation=false).
  # Successfully displaying the plan must always return success so
  # run_restore_plan can proceed to user confirmation.
  return 0
}

run_restore_plan() {
  local source="$1"
  local do_packages="$2"
  local do_configs="$3"
  local do_gnome="$4"
  local do_project="$5"

  show_restore_plan "$source" "$do_packages" "$do_configs" "$do_gnome" "$do_project" false || return 1
  confirm "Execute this restoration plan?" || { warn "Restoration cancelled."; return 0; }

  backup_safety
  restore_selected_components "$source" "$do_packages" "$do_configs" "$do_gnome" "$do_project"
}

restore_by_situation() {
  local situation="$1"
  local backup extracted status=0
  local do_packages=false do_configs=false do_gnome=false do_project=false

  backup="$(latest_backup 'ArchMind-*.archmind')"
  [[ -n "$backup" ]] || {
    error "No ArchMind backup found."
    return 1
  }

  info "Most recent backup:"
  echo "  $backup"

  extracted="$(extract_archmind "$backup")"
  if ! (verify_extracted "$extracted"); then
    remove_temp_dir "$extracted" || true
    return 1
  fi
  show_backup_summary "$extracted"

  case "$situation" in
    formatacao)
      do_packages=true
      [[ -d "${extracted}/configs" ]] && do_configs=true
      [[ -d "${extracted}/gnome" ]] && do_gnome=true
      [[ -d "${extracted}/project" ]] && do_project=true
      warn "New Arch Linux mode: packages will be installed first."
      run_restore_plan "$extracted" "$do_packages" "$do_configs" "$do_gnome" "$do_project" || status=$?
      ;;
    sistema_atual)
      [[ -d "${extracted}/configs" ]] && do_configs=true
      [[ -d "${extracted}/gnome" ]] && confirm "Also restore GNOME and extensions?" && do_gnome=true
      [[ -d "${extracted}/project" ]] && confirm "Also restore the ArchMind project?" && do_project=true
      warn "Packages will not be installed in this mode."
      run_restore_plan "$extracted" false "$do_configs" "$do_gnome" "$do_project" || status=$?
      ;;
    componente)
      choose_restore_components "$extracted" || status=$?
      ;;
    migracao)
      warn "Migration may load settings specific to the previous computer."
      [[ -d "${extracted}/configs" ]] && do_configs=true
      [[ -d "${extracted}/project" ]] && do_project=true
      [[ -d "${extracted}/gnome" ]] && confirm "Also restore GNOME and extensions?" && do_gnome=true
      [[ -d "${extracted}/packages" ]] && confirm "Install recorded packages on the new machine?" && do_packages=true
      show_restore_plan "$extracted" "$do_packages" "$do_configs" "$do_gnome" "$do_project" false || true
      warn "Review drivers, monitors, audio, and machine-specific paths before confirming."
      if confirm "Proceed with the selected migration?"; then
        backup_safety || status=$?
        if (( status == 0 )); then
          restore_selected_components "$extracted" "$do_packages" "$do_configs" "$do_gnome" "$do_project" || status=$?
        fi
      fi
      ;;
    simulacao)
      echo "Choose the scenario to simulate:"
      echo "1) Newly formatted system"
      echo "2) Current system, without packages"
      echo "3) Migration to another computer"
      echo "0) Cancel"
      local option
      read -rp "Choice: " option
      case "$option" in
        1) show_restore_plan "$extracted" true true true true true ;;
        2) show_restore_plan "$extracted" false true true true true ;;
        3) show_restore_plan "$extracted" true true true true true
           warn "Hardware-dependent settings must be reviewed during migration." ;;
        0) warn "Simulation cancelled." ;;
        *) warn "Invalid option." ;;
      esac
      ;;
    *) warn "Invalid situation." ;;
  esac

  remove_temp_dir "$extracted"
  if (( status != 0 )); then
    error "Restoration was not completed. Review the messages above before trying again."
  fi
  return "$status"
}

list_safety_copies() {
  ensure_dirs
  local found=0 item
  echo "SAFETY COPIES"
  echo
  while IFS= read -r item; do
    [[ -n "$item" ]] || continue
    found=1
    printf '  %s\n' "$item"
  done < <(find "$SAFETY_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort -r)
  [[ "$found" -eq 1 ]] || warn "No safety copy found."
  echo
  warn "Automatic recovery of these copies does not remove current files; use them as a safe source for manual recovery."
}

enable_multilib() {
  require_arch

  if pacman -Sl multilib >/dev/null 2>&1; then
    ok "multilib is already enabled."
    return 0
  fi

  info "Habilitando multilib..."

  sudo cp -a /etc/pacman.conf \
    "/etc/pacman.conf.archmind-$(date +'%Y%m%d-%H%M%S').bak"

  sudo sed -i \
    '/^#\[multilib\]/,/^#Include = \/etc\/pacman.d\/mirrorlist/ {
      s/^#\[multilib\]/[multilib]/
      s/^#Include = \/etc\/pacman.d\/mirrorlist/Include = \/etc\/pacman.d\/mirrorlist/
    }' /etc/pacman.conf

  # Avoid a partial update after enabling multilib.
  sudo pacman -Syu --noconfirm
}

install_yay() {
  require_arch

  if has yay; then
    ok "yay is already installed."
    return 0
  fi

  sudo pacman -S --needed --noconfirm base-devel git

  local dir
  dir="$(mktemp -d)"

  git clone https://aur.archlinux.org/yay.git "${dir}/yay"

  (
    cd "${dir}/yay"
    makepkg -si --needed --noconfirm
  )

  rm -rf "$dir"
  if ! has yay; then
    error "Failed to install yay."
    return 1
  fi
}

install_available() {
  local title="$1"
  shift

  local available=()
  local missing=()
  local pkg

  for pkg in "$@"; do
    if pacman -Si "$pkg" >/dev/null 2>&1; then
      available+=("$pkg")
    else
      missing+=("$pkg")
    fi
  done

  if [[ "${#available[@]}" -gt 0 ]]; then
  info "Installing: $title"
    sudo pacman -S --needed --noconfirm "${available[@]}"
  fi

  if [[ "${#missing[@]}" -gt 0 ]]; then
    warn "Packages not found:"
    printf '  - %s\n' "${missing[@]}"
  fi
}

configure_file_templates() {
  local templates_dir=""
  local template

  if has xdg-user-dirs-update; then
    xdg-user-dirs-update >/dev/null 2>&1 || true
  fi

  if has xdg-user-dir; then
    templates_dir="$(xdg-user-dir TEMPLATES 2>/dev/null || true)"
  fi

  # When TEMPLATES is not configured, xdg-user-dir may return Home.
  # Never create loose templates directly in this directory.
  if [[ -z "$templates_dir" || "$templates_dir" == "$HOME" || \
        "$templates_dir" == "$HOME/" ]]; then
    templates_dir="$HOME/Templates"
    if has xdg-user-dirs-update; then
      xdg-user-dirs-update --set TEMPLATES "$templates_dir" \
        >/dev/null 2>&1 || true
    fi
  fi

  mkdir -p -- "$templates_dir"

  for template in \
    "Documento vazio.txt" \
    "Script Python.py" \
    "Script Shell.sh" \
    "Documento Markdown.md"; do
    [[ -e "$templates_dir/$template" || -L "$templates_dir/$template" ]] || \
      : > "$templates_dir/$template"
  done

  ok "New Document menu templates configured at: $templates_dir"
}

