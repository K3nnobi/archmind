#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

APP="archmind-manager"
VERSION="1.5.18"

ROOT_DIR="${HOME}/ArchMind"
SYSTEM_DIR="${ROOT_DIR}/System"
BACKUP_DIR="${ROOT_DIR}/Backups"
PROJECT_DIR="${ARCHMIND_PROJECT_DIR:-${SYSTEM_DIR}/Core}"
CONFIG_DIR="${ROOT_DIR}/Config"
ZSH_CONFIG_DIR="${CONFIG_DIR}/Zsh"
ALIASES_FILE="${ZSH_CONFIG_DIR}/aliases.zsh"
P10K_FILE="${ZSH_CONFIG_DIR}/p10k.zsh"
SAFETY_DIR="${BACKUP_DIR}/Safety"
TEMP_DIR="${ROOT_DIR}/Temp"
LOG_DIR="${ROOT_DIR}/Logs"

USER_EXT_DIR="${HOME}/.local/share/gnome-shell/extensions"
NAUTILUS_HELPER="${PROJECT_DIR}/tools/configure-nautilus.sh"
GNOME_APPEARANCE_HELPER="${PROJECT_DIR}/tools/configure-gnome-appearance.sh"
GAMEMODE_BLUR_HELPER="${PROJECT_DIR}/tools/configure-gamemode-blur.sh"
GNOME_DRAG_HOVER_HELPER="${PROJECT_DIR}/tools/configure-gnome-drag-hover.py"
WINE_COMPATIBILITY_HELPER="${PROJECT_DIR}/tools/configure-wine-compatibility.sh"
CAPSLOCK_NODELAY_HELPER="${PROJECT_DIR}/tools/configure-capslock-nodelay.sh"
FIREFOX_EMOJI_HELPER="${PROJECT_DIR}/tools/configure-firefox-chatgpt-emoji.py"
NVIBRANT_HELPER="${PROJECT_DIR}/tools/configure-nvibrant.sh"
PLYMOUTH_PATCH_HELPER="${PROJECT_DIR}/patches/plymouth/plymouth-patch.sh"
MAINTENANCE_TOOLS_DIR="${PROJECT_DIR}/tools"

info()  { printf '\033[1;34m[INFO]\033[0m %s\n' "$*"; }
ok()    { printf '\033[1;32m[ OK ]\033[0m %s\n' "$*"; }
warn()  { printf '\033[1;33m[WARNING]\033[0m %s\n' "$*"; }
error() { printf '\033[1;31m[ERROR]\033[0m %s\n' "$*" >&2; }
die()   { error "$*"; exit 1; }

has() {
  command -v "$1" >/dev/null 2>&1
}

pause() {
  echo
  read -rp "Press Enter to continue..." _
}

confirm() {
  local answer
  read -rp "$1 [y/N]: " answer
  [[ "${answer,,}" == "y" || "${answer,,}" == "yes" ]]
}

header() {
  clear
  cat <<EOF
╔══════════════════════════════════════════════╗
║          ArchMind Manager ${VERSION}              ║
╚══════════════════════════════════════════════╝
EOF
  echo
}

ensure_dirs() {
  mkdir -p "$BACKUP_DIR" "$PROJECT_DIR" "$CONFIG_DIR" "$ZSH_CONFIG_DIR" \
    "$SAFETY_DIR" "$TEMP_DIR" "$LOG_DIR"
}

require_normal_user() {
  [[ "$EUID" -ne 0 ]] || die "Run as your normal user, not as root."
}

require_arch() {
  [[ -f /etc/arch-release ]] || die "Este script requer Arch Linux ou derivado."
  has pacman || die "pacman was not found."
}

latest_backup() {
  local pattern="$1"

  find "$BACKUP_DIR" -maxdepth 1 -type f -name "$pattern" \
    -printf '%T@ %p\n' 2>/dev/null \
    | sort -nr \
    | head -n1 \
    | cut -d' ' -f2-
}

make_temp_dir() {
  mktemp -d "${TEMP_DIR}/archmind.XXXXXX"
}

create_checksums() {
  local dir="$1"

  (
    cd "$dir"
    find . -type f ! -name 'checksums.sha256' -print0 \
      | sort -z \
      | xargs -0 sha256sum > checksums.sha256
  )
}

pack_archmind() {
  local source="$1"
  local destination="$2"

  create_checksums "$source"
  (
    unset TAR_OPTIONS
    command tar \
      -C "$source" \
      --create \
      --auto-compress \
      --file="$destination" \
      --exclude='*.sock' \
      --warning=no-file-ignored \
      .
  )
  sha256sum "$destination" > "${destination}.sha256"

  ok "File created: $destination"
}

is_safe_archive_path() {
  local path="$1"

  # Backups created by ArchMind use relative names beginning with "./".
  # Backslashes are refused so control names escaped by the tar listing are
  # never interpreted as ordinary paths.
  [[ -n "$path" ]] || return 1
  [[ "$path" != /* ]] || return 1
  [[ "$path" != *\\* ]] || return 1
  [[ "$path" != *$'\r'* && "$path" != *$'\n'* ]] || return 1
  [[ ! "$path" =~ (^|/)\.\.(/|$) ]] || return 1

  return 0
}

validate_archive_paths() {
  local source="$1"
  local listing entry

  [[ -f "$source" ]] || die "Backup file not found: $source"

  listing="$(mktemp "${TEMP_DIR}/archive-list.XXXXXX")" \
    || die "Could not create the temporary backup list."

  if ! (
    unset TAR_OPTIONS
    command tar --list --file="$source" --quoting-style=escape
  ) > "$listing"; then
    rm -f -- "$listing"
    die "Could not read the backup structure."
  fi

  while IFS= read -r entry || [[ -n "$entry" ]]; do
    if ! is_safe_archive_path "$entry"; then
      rm -f -- "$listing"
      die "Unsafe path detected in the backup: $entry"
    fi
  done < "$listing"

  rm -f -- "$listing"
}

validate_checksum_paths() {
  local checksum_file="$1"
  local line hash separator path

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" ]] || continue

    hash="${line:0:64}"
    separator="${line:64:2}"
    path="${line:66}"

    if [[ ! "$hash" =~ ^[[:xdigit:]]{64}$ ]] \
      || [[ "$separator" != "  " && "$separator" != " *" ]] \
      || ! is_safe_archive_path "$path"; then
      die "Invalid or unsafe entry in checksums.sha256."
    fi
  done < "$checksum_file"
}

validate_extracted_layout() {
  local dir="$1"
  local component

  for component in configs gnome packages project; do
    if [[ -e "${dir}/${component}" || -L "${dir}/${component}" ]]; then
      [[ -d "${dir}/${component}" && ! -L "${dir}/${component}" ]] \
        || die "Invalid backup component: $component"
    fi
  done
}

remove_temp_dir() {
  local dir="${1:-}"

  case "$dir" in
    "${TEMP_DIR}"/archmind.*)
      [[ -e "$dir" ]] && rm -rf -- "$dir"
      ;;
    *)
      error "Refused to remove a temporary directory outside ArchMind: $dir"
      return 1
      ;;
  esac
}

extract_archmind() {
  local source="$1"
  local destination

  validate_archive_paths "$source"
  destination="$(make_temp_dir)"

  if ! (
    unset TAR_OPTIONS
    command tar \
      --extract \
      --file="$source" \
      --directory="$destination" \
      --no-same-owner \
      --delay-directory-restore
  ); then
    remove_temp_dir "$destination" || true
    die "Backup extraction failed. No restoration was started."
  fi

  printf '%s\n' "$destination"
}

verify_extracted() {
  local dir="$1"

  [[ -f "${dir}/manifest.txt" && ! -L "${dir}/manifest.txt" ]] \
    || die "Missing or invalid manifest."
  [[ -f "${dir}/checksums.sha256" && ! -L "${dir}/checksums.sha256" ]] \
    || die "Missing or invalid hashes."

  validate_extracted_layout "$dir"
  validate_checksum_paths "${dir}/checksums.sha256"

  (
    cd "$dir"
    sha256sum -c -- checksums.sha256 >/dev/null
  ) || die "The backup is corrupted or incomplete."
}

copy_home_path_to_safety() {
  local destination="$1"
  local relative="$2"
  local source="${HOME}/${relative}"
  local target="${destination}/${relative}"

  [[ -e "$source" || -L "$source" ]] || return 0

  mkdir -p "$(dirname "$target")"

  if [[ -d "$source" && ! -L "$source" ]]; then
    # Tar preserves permissions and ignores temporary sockets (for example,
    # libvirt monitor.sock), which cannot and must not be restored.
    (
      cd "$HOME"
      unset TAR_OPTIONS
      command tar \
        --create \
        --file=- \
        --warning=no-file-ignored \
        -- "$relative"
    ) | (
      cd "$destination"
      unset TAR_OPTIONS
      command tar \
        --extract \
        --file=- \
        --no-same-owner \
        --delay-directory-restore
    )
  else
    cp -a -- "$source" "$target"
  fi
}

backup_safety() {
  local destination="${SAFETY_DIR}/before-restore-$(date +'%Y%m%d-%H%M%S')"
  local relative
  local home_paths=(
    ".config"
    ".bashrc"
    ".bash_profile"
    ".zshrc"
    ".zprofile"
    ".zshenv"
    ".p10k.zsh"
    ".zsh_aliases"
    ".profile"
    ".gitconfig"
    ".gtkrc-2.0"
    ".Xresources"
    ".vimrc"
    ".nanorc"
    ".tmux.conf"
    ".themes"
    ".icons"
    ".fonts"
    ".local/share/themes"
    ".local/share/icons"
    ".local/share/fonts"
    ".local/share/thumbnailers"
    ".local/share/gnome-shell/extensions"
    ".local/bin"
    "ArchMind/Config"
  )

  mkdir -p -m 700 "$destination"

  for relative in "${home_paths[@]}"; do
    copy_home_path_to_safety "$destination" "$relative"
  done

  # Keep a second organized copy of files loaded by Zsh, including those
  # outside ~/.config and the standard hidden filenames.
  capture_zsh_dependencies "${destination}/zsh-dependencies"

  has dconf && dconf dump / > "${destination}/full.dconf" 2>/dev/null || true

  ok "Safety copy: $destination"
}

is_ignored_zsh_file() {
  local file="$1"
  local base
  base="$(basename "$file")"

  case "$base" in
    .zsh_history|.bash_history|*.backup|*.bak|*.old|*.tmp)
      return 0
      ;;
  esac

  return 1
}

normalize_home_path() {
  local raw="$1"

  raw="${raw%%#*}"
  raw="${raw%;}"
  raw="${raw%\"}"
  raw="${raw#\"}"
  raw="${raw%\'}"
  raw="${raw#\'}"

  raw="${raw/#\~/$HOME}"
  raw="${raw//\$\{HOME\}/$HOME}"
  raw="${raw//\$HOME/$HOME}"

  [[ "$raw" == /* ]] || raw="${HOME}/${raw#./}"

  realpath -m -- "$raw"
}

detect_zsh_dependencies() {
  local config line candidate normalized
  local configs=(
    "${HOME}/.zshrc"
    "${HOME}/.zprofile"
    "${HOME}/.zshenv"
  )

  {
    local standard
    for standard in \
      "${HOME}/.zshrc" \
      "${HOME}/.zprofile" \
      "${HOME}/.zshenv" \
      "${HOME}/.p10k.zsh" \
      "${HOME}/.zsh_aliases"; do
      [[ -f "$standard" ]] && printf '%s\n' "$standard"
    done

    for config in "${configs[@]}"; do
      [[ -f "$config" ]] || continue

      while IFS= read -r line; do
        candidate=""

        if [[ "$line" =~ (^|[[:space:];&])source[[:space:]]+([^[:space:];&]+) ]]; then
          candidate="${BASH_REMATCH[2]}"
        elif [[ "$line" =~ (^|[[:space:];&])\.[[:space:]]+([^[:space:];&]+) ]]; then
          candidate="${BASH_REMATCH[2]}"
        fi

        [[ -n "$candidate" ]] || continue
        normalized="$(normalize_home_path "$candidate")"

        [[ "$normalized" == "${HOME}/"* ]] || continue
        [[ -f "$normalized" ]] || continue
        is_ignored_zsh_file "$normalized" && continue

        printf '%s\n' "$normalized"
      done < "$config"
    done

    find "$HOME" -maxdepth 1 -type f \
      \( -name '*.zsh' -o -name '.zsh_*' \) \
      ! -name '.zsh_history' \
      ! -name '*.backup' \
      ! -name '*.bak' \
      -print 2>/dev/null
  } | sort -u
}

capture_zsh_dependencies() {
  local target="$1"
  local list="${target}/zsh-files.txt"
  local file relative destination

  mkdir -p "${target}/zsh-linked"
  detect_zsh_dependencies > "$list"

  while IFS= read -r file; do
    [[ -f "$file" ]] || continue
    relative="${file#${HOME}/}"
    destination="${target}/zsh-linked/${relative}"
    mkdir -p "$(dirname "$destination")"
    cp -a -- "$file" "$destination"
  done < "$list"
}

show_detected_zsh_files() {
  echo "Detected Zsh files:"
  echo

  local count=0 file
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    printf '  %s\n' "$file"
    count=$((count + 1))
  done < <(detect_zsh_dependencies)

  echo
  echo "Total: $count file(s)."
  echo
  echo "History and .backup/.bak files are ignored."
}

import_zsh_modules_to_project() {
  ensure_dirs

  local destination="${PROJECT_DIR}/modules/imported"
  local safety="${SAFETY_DIR}/zsh-project-before-import-$(date +'%Y%m%d-%H%M%S')"
  local file base copied=0

  mkdir -p "$destination"

  if [[ -n "$(find "$destination" -mindepth 1 -print -quit 2>/dev/null)" ]]; then
    mkdir -p "$safety"
    cp -a "${destination}/." "$safety/"
    ok "Safety copy of existing modules: $safety"
  fi

  while IFS= read -r file; do
    [[ -f "$file" ]] || continue
    base="$(basename "$file")"

    case "$base" in
      .zshrc|.zprofile|.zshenv|.p10k.zsh|.zsh_aliases)
        continue
        ;;
    esac

    cp -a -- "$file" "${destination}/${base}"
    copied=$((copied + 1))
  done < <(detect_zsh_dependencies)

  cat > "${destination}/loader.zsh" <<'EOF'
# ArchMind Zsh module loader
# Load every .zsh module in this directory except this loader itself.

ARCHMIND_ZSH_DIR="${HOME}/ArchMind/Config/Zsh/modules"

for module in "${ARCHMIND_ZSH_DIR}"/*.zsh; do
  [[ -f "$module" ]] || continue
  [[ "$(basename "$module")" == "loader.zsh" ]] && continue
  source "$module"
done

unset module ARCHMIND_ZSH_DIR
EOF

  cat > "${destination}/README.txt" <<'EOF'
This directory contains copies of custom Zsh modules.

The importer does not delete or modify original files in Home.

To start using these modules, add this to ~/.zshrc:

[[ -f "$HOME/ArchMind/Config/Zsh/modules/loader.zsh" ]] && \
  source "$HOME/ArchMind/Config/Zsh/modules/loader.zsh"

Before doing so, remove or comment out old lines that load the same modules
to prevent them from being executed twice.
EOF

  ok "$copied module(s) copied to: $destination"
  warn "The originals were not deleted and ~/.zshrc was not modified."
}

capture_configs() {
  local target="$1"
  mkdir -p "$target"

  local files=(
    ".bashrc"
    ".bash_profile"
    ".zshrc"
    ".zprofile"
    ".zshenv"
    ".p10k.zsh"
    ".zsh_aliases"
    ".profile"
    ".gitconfig"
    ".gtkrc-2.0"
    ".Xresources"
    ".vimrc"
    ".nanorc"
    ".tmux.conf"
  )

  local file
  for file in "${files[@]}"; do
    [[ -e "${HOME}/${file}" ]] || continue
    case "$file" in
      .zsh_aliases|.p10k.zsh)
        # Store actual configuration, never an absolute compatibility link.
        cp -aL -- "${HOME}/${file}" "$target/"
        ;;
      *) cp -a -- "${HOME}/${file}" "$target/" ;;
    esac
  done

  capture_zsh_dependencies "$target"

  if [[ -d "$CONFIG_DIR" ]]; then
    mkdir -p "${target}/archmind-config"
    cp -a -- "$CONFIG_DIR/." "${target}/archmind-config/"
  fi

  if [[ -f "$PROJECT_DIR/tools/doctor-report.py" ]] && has python3; then
    python3 -B "$PROJECT_DIR/tools/doctor-report.py" --export "$target/archmind-doctor-reports" || \
      warn "Doctor reports could not be fully included in the backup."
  elif [[ -d "$LOG_DIR/Doctor" ]]; then
    warn "Doctor reports were not backed up: the report helper or Python is missing."
  fi

  if [[ -d "${HOME}/.config" ]]; then
    mkdir -p "${target}/.config"

    if has rsync; then
      rsync -a \
        --exclude='archmind/' \
        --exclude='Cache/' \
        --exclude='cache/' \
        --exclude='GPUCache/' \
        --exclude='Code Cache/' \
        --exclude='logs/' \
        --exclude='Logs/' \
        --exclude='*.sock' \
        --exclude='google-chrome/' \
        --exclude='chromium/' \
        --exclude='BraveSoftware/' \
        --exclude='discord/' \
        --exclude='TelegramDesktop/' \
        "${HOME}/.config/" "${target}/.config/"
    else
      local config_item config_name
      while IFS= read -r -d '' config_item; do
        config_name="$(basename "$config_item")"
        [[ "$config_name" == "archmind" ]] && continue
        cp -a -- "$config_item" "${target}/.config/"
      done < <(find "${HOME}/.config" -mindepth 1 -maxdepth 1 -print0)
    fi
  fi

  local path
  for path in \
    ".themes" \
    ".icons" \
    ".fonts" \
    ".local/share/themes" \
    ".local/share/icons" \
    ".local/share/fonts" \
    ".local/share/thumbnailers" \
    ".local/bin"; do

    if [[ "$path" == ".local/bin" && -d "${HOME}/${path}" ]]; then
      mkdir -p "${target}/${path}"
      local bin_item bin_name
      while IFS= read -r -d '' bin_item; do
        bin_name="$(basename "$bin_item")"
        [[ "$bin_name" == "archmind" || "$bin_name" == "archmind-console" || "$bin_name" == "archmind-monitor" ]] && continue
        cp -a -- "$bin_item" "${target}/${path}/"
      done < <(find "${HOME}/${path}" -mindepth 1 -maxdepth 1 -print0)
    elif [[ -e "${HOME}/${path}" ]]; then
      mkdir -p "$(dirname "${target}/${path}")"
      cp -a "${HOME}/${path}" "${target}/${path}"
    fi
  done
}

configure_nautilus_integration() {
  if [[ ! -f "$NAUTILUS_HELPER" ]]; then
    warn "Nautilus configurator not found: $NAUTILUS_HELPER"
    return 0
  fi

  if ! bash "$NAUTILUS_HELPER" --apply; then
    warn "The optional Nautilus integration failed; ArchMind will continue normally."
  fi

  return 0
}

configure_gnome_appearance_integration() {
  if [[ ! -f "$GNOME_APPEARANCE_HELPER" ]]; then
    warn "GNOME appearance configurator not found: $GNOME_APPEARANCE_HELPER"
    return 0
  fi

  if ! bash "$GNOME_APPEARANCE_HELPER" --apply; then
    warn "The optional GNOME appearance integration failed; ArchMind will continue normally."
  fi

  return 0
}

configure_gamemode_blur_integration() {
  if [[ ! -f "$GAMEMODE_BLUR_HELPER" ]]; then
    warn "GameMode + Blur configurator not found: $GAMEMODE_BLUR_HELPER"
    return 0
  fi

  if ! bash "$GAMEMODE_BLUR_HELPER" --apply; then
    warn "The optional GameMode + Blur integration failed; ArchMind will continue normally."
  fi

  return 0
}

open_gamemode_blur_integration() {
  if [[ ! -f "$GAMEMODE_BLUR_HELPER" ]]; then
    warn "GameMode + Blur configurator not found: $GAMEMODE_BLUR_HELPER"
    return 0
  fi

  bash "$GAMEMODE_BLUR_HELPER" --menu || \
    warn "The GameMode + Blur action was not completed."
}

open_gnome_drag_hover() {
  if [[ ! -f "$GNOME_DRAG_HOVER_HELPER" || -L "$GNOME_DRAG_HOVER_HELPER" ]]; then
    warn "GNOME Drag Hover helper not found: $GNOME_DRAG_HOVER_HELPER"
    return 1
  fi
  has python3 || {
    warn "Python 3 is required for GNOME Drag Hover."
    return 1
  }
  python3 -B "$GNOME_DRAG_HOVER_HELPER" --menu || \
    warn "The GNOME Drag Hover action was not completed."
}

open_wine_compatibility_pack() {
  if [[ ! -f "$WINE_COMPATIBILITY_HELPER" ]]; then
    warn "Wine Compatibility Pack not found: $WINE_COMPATIBILITY_HELPER"
    return 1
  fi
  bash "$WINE_COMPATIBILITY_HELPER" --menu || \
    warn "The Wine Compatibility Pack action was not completed."
}

