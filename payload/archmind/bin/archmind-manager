list_backups() {
  local found=0

  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    found=1
    echo "$file"
  done < <(
    find "$BACKUP_DIR" -maxdepth 1 -type f -name '*.archmind' | sort
  )

  [[ "$found" -eq 1 ]] || warn "No backup found."
}

backup_menu() {
  while true; do
    header

    cat <<'EOF'
BACKUP

1) Full backup
2) Settings backup
3) GNOME and extensions backup
4) Package backup
5) Back up the ArchMind project
6) List backups

0) Back
EOF

    echo
    read -rp "Choice: " choice

    case "$choice" in
      1) create_backup completo; pause ;;
      2) create_backup configuracoes; pause ;;
      3) create_backup gnome; pause ;;
      4) create_backup pacotes; pause ;;
      5) create_backup projeto; pause ;;
      6) list_backups; pause ;;
      0) return 0 ;;
      *) warn "Invalid option."; pause ;;
    esac
  done
}

advanced_restore_menu() {
  while true; do
    header
    cat <<'EOF'
RESTORATION — ADVANCED OPTIONS

1) Full backup by type
2) Settings only
3) GNOME and extensions only
4) Packages only
5) ArchMind project only
6) Latest backup with manual selection

0) Back
EOF
    echo
    read -rp "Choice: " choice
    case "$choice" in
      1) restore_backup completo; pause ;;
      2) restore_backup configuracoes; pause ;;
      3) restore_backup gnome; pause ;;
      4) restore_backup pacotes; pause ;;
      5) restore_backup projeto; pause ;;
      6) restore_backup qualquer; pause ;;
      0) return 0 ;;
      *) warn "Invalid option."; pause ;;
    esac
  done
}

restore_menu() {
  while true; do
    header

    cat <<'EOF'
RESTORATION BY SITUATION

1) Recover system after formatting
   Install packages first, then restore the environment

2) Restore settings on the current system
   Do not reinstall programs automatically

3) Recover specific components
   Choose settings, GNOME, packages, or project

4) Migrate to another computer
   Display warnings for hardware-dependent settings

5) Verify and simulate restoration
   Show the impact without modifying the system

6) List safety copies
7) Advanced options

0) Back
EOF

    echo
    read -rp "Choice: " choice

    case "$choice" in
      1) restore_by_situation formatacao; pause ;;
      2) restore_by_situation sistema_atual; pause ;;
      3) restore_by_situation componente; pause ;;
      4) restore_by_situation migracao; pause ;;
      5) restore_by_situation simulacao; pause ;;
      6) list_safety_copies; pause ;;
      7) advanced_restore_menu ;;
      0) return 0 ;;
      *) warn "Invalid option."; pause ;;
    esac
  done
}

install_menu() {
  while true; do
    header

    cat <<'EOF'
INSTALLATION

1) Base Profile
   Firefox, Yay, Pamac, fonts, codecs, PipeWire, and utilities

2) Terminal Profile
   Zsh, plugins, Powerlevel10k, Kitty, and terminal tools

3) Gaming Profile
   Steam, Wine, Winetricks, Lutris, MangoHud, and GameMode

4) Audio Profile
   EasyEffects, LV2 plugins, Helvum, and QpwGraph

5) Development Profile
   Python, Node.js, Docker, compilers, and VS Code

6) Install all profiles

7) Configure Nautilus integration
   Folders first, real .exe icons, and transparent thumbnails

8) Configure GNOME appearance
   Rounded blur for Blur My Shell and yellow Papirus-Dark folders

9) Configure GameMode + Blur My Shell
   Disable blur during games and restore its state when they close

10) Configure NVIDIA Digital Vibrance
    Intensity, automatic service, status, and removal

11) Plymouth / Boot Visual
    Independent, auditable, reversible patch for spinner and GRUB

12) Wine Compatibility Pack
    Runtimes, fonts, and legacy DirectX in a selected Wine prefix

13) GNOME Drag Hover
    Raise applications and windows while dragging files on Wayland

14) Caps Lock No Delay
    Remove the Caps Lock release delay using keyd

15) Firefox / ChatGPT Color Emoji Fix
    Prioritize color emoji without changing normal text spacing

0) Back
EOF

    echo
    read -rp "Choice: " choice

    case "$choice" in
      1) install_base; pause ;;
      2) install_terminal; pause ;;
      3) install_gaming; pause ;;
      4) install_audio; pause ;;
      5) install_development; pause ;;
      6) install_all_profiles; pause ;;
      7) configure_nautilus_integration; pause ;;
      8) configure_gnome_appearance_integration; pause ;;
      9) open_gamemode_blur_integration; pause ;;
      10) open_nvibrant_integration; pause ;;
      11) open_plymouth_patch; pause ;;
      12) open_wine_compatibility_pack; pause ;;
      13) open_gnome_drag_hover; pause ;;
      14) open_capslock_nodelay; pause ;;
      15) open_firefox_chatgpt_emoji; pause ;;
      0) return 0 ;;
      *) warn "Invalid option."; pause ;;
    esac
  done
}

project_menu() {
  while true; do
    header

    cat <<'EOF'
ARCHMIND PROJECT

1) Back up project
2) Restore project
3) Import Zsh modules into the project
4) Show detected Zsh files
5) Show project location in the terminal

0) Back
EOF

    echo
    read -rp "Choice: " choice

    case "$choice" in
      1) create_backup projeto; pause ;;
      2) restore_backup projeto; pause ;;
      3) import_zsh_modules_to_project; pause ;;
      4) show_detected_zsh_files; pause ;;
      5)
        echo "$PROJECT_DIR"
        pause
        ;;
      0) return 0 ;;
      *) warn "Invalid option."; pause ;;
    esac
  done
}

main_menu() {
  while true; do
    header

    cat <<'EOF'
1) Backup
2) Restoration
3) Installation
4) ArchMind Project
5) Show ArchMind directories
6) Maintenance Center

0) Exit
EOF

    echo
    read -rp "Choice: " choice

    case "$choice" in
      1) backup_menu ;;
      2) restore_menu ;;
      3) install_menu ;;
      4) project_menu ;;
      5)
        echo "Root:      $ROOT_DIR"
        echo "Backups:   $BACKUP_DIR"
        echo "Project:   $PROJECT_DIR"
        echo "Safety:    $SAFETY_DIR"
        pause
        ;;
      6) maintenance_menu ;;
      0)
        ok "Exiting."
        exit 0
        ;;
      *)
        warn "Invalid option."
        pause
        ;;
    esac
  done
}

main() {
  require_normal_user
  ensure_dirs
  main_menu
}

main "$@"
