#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

readonly VERSION="@VERSION@"
readonly EXPECTED_ARCHIVE_SHA256="@ARCHIVE_SHA256@"
readonly PAYLOAD_MARKER="__ARCHMIND_PAYLOAD_BELOW__"
readonly SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"

temporary_directory=""
running_install=0
mode=install

info()  { printf '\033[1;34m[INFO]\033[0m %s\n' "$*"; }
ok()    { printf '\033[1;32m[ OK ]\033[0m %s\n' "$*"; }
warn()  { printf '\033[1;33m[WARNING]\033[0m %s\n' "$*"; }
error() { printf '\033[1;31m[ERROR]\033[0m %s\n' "$*" >&2; }
die()   { error "$*"; exit 1; }

cleanup() {
    if [[ -n "$temporary_directory" && -d "$temporary_directory" ]]; then
        case "${temporary_directory##*/}" in
            archmind-installer.*)
                cd / || return 1
                rm -rf -- "$temporary_directory"
                ;;
        esac
    fi
    return 0
}

finish() {
    local status=$?
    trap - EXIT
    cleanup
    if (( status != 0 && running_install )) && [[ -t 0 ]]; then
        error "Installation was interrupted (exit code $status). The console was not opened."
        printf '\nPress Enter to close...'
        read -r _ || true
    fi
    exit "$status"
}

trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

usage() {
    cat <<HELP
ArchMind ${VERSION} — self-extracting installer

Usage:
  ./ArchMind-${VERSION}-Installer.run           Install and open the AFI
  ./ArchMind-${VERSION}-Installer.run --check   Verify the file
  ./ArchMind-${VERSION}-Installer.run --extract DIRECTORY
  ./ArchMind-${VERSION}-Installer.run --version

In GNOME Files, use "Open With → Run in Terminal" when available.
Double-click behavior depends on permissions and file-manager associations.
Alternative: bash ArchMind-${VERSION}-Installer.run (without sudo).
HELP
}

launch_terminal() {
    local -a command_line=(
        env ARCHMIND_RUN_IN_TERMINAL=1 bash "$SELF" "$@"
    )

    if command -v gnome-terminal >/dev/null 2>&1; then
        exec gnome-terminal --wait -- "${command_line[@]}"
    elif command -v kgx >/dev/null 2>&1; then
        exec kgx -- "${command_line[@]}"
    elif command -v konsole >/dev/null 2>&1; then
        exec konsole -e "${command_line[@]}"
    elif command -v xterm >/dev/null 2>&1; then
        exec xterm -e "${command_line[@]}"
    fi

    if command -v zenity >/dev/null 2>&1; then
        zenity --error \
            --title="ArchMind Installer" \
            --text="No compatible terminal was found. Open a terminal and run the file with bash." || true
    fi
    die "No compatible terminal was found."
}

payload_line() {
    awk -v marker="$PAYLOAD_MARKER" \
        '$0 == marker { print NR + 1; exit }' "$SELF"
}

verify_embedded_archive() {
    local first_line="$1"
    local actual_sha256=""

    [[ "$first_line" =~ ^[0-9]+$ ]] || die "Embedded package marker not found."
    actual_sha256="$(tail -n +"$first_line" -- "$SELF" | sha256sum | awk '{print $1}')"
    [[ "$actual_sha256" == "$EXPECTED_ARCHIVE_SHA256" ]] ||
        die "The self-extracting installer failed its integrity check. Download it again."
}

extract_embedded_archive() {
    local first_line="$1"
    local destination="$2"

    mkdir -p -- "$destination"
    tail -n +"$first_line" -- "$SELF" | tar -xzf - --no-same-owner -C "$destination"
    [[ -x "$destination/ArchMind-${VERSION}/install.sh" ]] ||
        die "The main installer was not found in the embedded package."
}

case "${1:-}" in
    --help|-h)
        usage
        exit 0
        ;;
    --version|-v)
        printf 'ArchMind self-extracting installer %s\n' "$VERSION"
        exit 0
        ;;
    --check)
        [[ $# == 1 ]] || die 'Too many arguments for --check.'
        mode=check
        ;;
    --extract)
        [[ $# == 2 && -n "$2" ]] || die 'Usage: --extract DIRECTORY'
        mode=extract
        ;;
    "") (( $# == 0 )) || die 'An empty argument is not allowed.' ;;
    *) die "Unknown option: $1" ;;
esac

if [[ "$mode" == install && "${ARCHMIND_RUN_IN_TERMINAL:-0}" != "1" ]] &&
   { [[ ! -t 0 ]] || [[ ! -t 1 ]]; }; then
    launch_terminal "$@"
fi

if [[ "$mode" == install ]]; then
    running_install=1
    (( EUID != 0 )) || die 'Run as your normal user, without sudo.'
    [[ -t 0 && -t 1 ]] || die 'Installation requires an interactive terminal.'
fi

readonly FIRST_PAYLOAD_LINE="$(payload_line)"
verify_embedded_archive "$FIRST_PAYLOAD_LINE"

if [[ "$mode" == extract ]]; then
    [[ ! -L "$2" ]] || die 'The destination cannot be a symbolic link.'
    [[ ! -e "$2" || -d "$2" ]] || die "The destination exists and is not a directory."
    if [[ -d "$2" && -n "$(find "$2" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then
        die 'The destination is not empty; no file was replaced.'
    fi
    extract_embedded_archive "$FIRST_PAYLOAD_LINE" "$2"
    ok "Package extracted to: $2/ArchMind-${VERSION}"
    exit 0
fi

temporary_directory="$(mktemp -d "${TMPDIR:-/tmp}/archmind-installer.XXXXXX")"
extract_embedded_archive "$FIRST_PAYLOAD_LINE" "$temporary_directory"
cd -- "$temporary_directory/ArchMind-${VERSION}"

if [[ "$mode" == check ]]; then
    ./install.sh --check
    ok "ArchMind ${VERSION} self-extracting installer passed integrity verification."
    exit 0
fi

printf '\nARCHMIND %s — SIMPLIFIED INSTALLATION\n\n' "$VERSION"
info "Verifying the embedded package..."
./install.sh --check
info "Displaying the installation plan..."
./install.sh --dry-run
printf '\n'
read -r -p 'Install or update ArchMind according to this plan? [y/N]: ' answer || exit 0
[[ "${answer,,}" == y || "${answer,,}" == yes ]] || { info 'Installation cancelled.'; exit 0; }
./install.sh --organize-home

console="$HOME/.local/bin/archmind-console"
[[ -x "$console" ]] ||
    die "Installation finished, but archmind-console was not found."

ok "Installation complete. Opening ArchMind Console..."
running_install=0
cleanup
temporary_directory=""
trap - EXIT
cd -- "$HOME"
exec "$console"

__ARCHMIND_PAYLOAD_BELOW__
